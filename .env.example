# CastNexus dns configuration.
CASTNEXUS_IMAGE_TAG=latest

# --- LAN console interception ------------------------------------------------
# Leave DNS_MODE unset/lan for the normal LAN interceptor. PI_IP is used as the
# redirect target when DNS_REDIRECT_IP is not set.
PI_IP=192.168.1.50
DNS_LISTEN=0.0.0.0
DNS_PORT=53
DNS_UPSTREAM=1.1.1.1
DNS_UPSTREAM_PORT=53
DNS_UPSTREAM_TIMEOUT_MS=2500
DNS_LOG_ALL=true

# --- Optional VPS/public console gateway -----------------------------------
# A remote console can point its manually configured DNS server at the VPS.
# CastNexus DNS then returns PUBLIC_IP for the platform's plain-RTMP ingest
# hostnames so the console connects directly to MediaMTX on the VPS. No ARP
# spoofing is used in this mode. See docs/VPS-CONSOLE-GATEWAY.md.
#
# IMPORTANT: use your HOME INTERNET'S PUBLIC/WAN IP here, not the console's
# 192.168.x.x LAN address. Keeping DNS_ALLOWED_CLIENTS set prevents this from
# becoming an open recursive DNS server.
DNS_MODE=lan
DNS_PUBLIC_MODE=false
DNS_REDIRECT_IP=
DNS_REDIRECT_IPV6=
DNS_ALLOWED_CLIENTS=
DNS_ALLOW_ANY=false
PUBLIC_IP=
PUBLIC_IPV6=
