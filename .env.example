# CastNexus Docker release channel
# Stable: latest images + normal GitHub Releases
CASTNEXUS_IMAGE_TAG=latest
CASTNEXUS_CHANNEL=stable
# Beta testing instead:
# CASTNEXUS_IMAGE_TAG=beta
# CASTNEXUS_CHANNEL=beta

# Host LAN IP. On a VPS this can be the VPS public IPv4 when you want Studio
# links to advertise that address, although reverse-proxy deployments usually
# use their public domain in the OAuth redirect variables below.
PI_IP=192.168.1.50

# Console LAN IPs (comma separated) and LAN gateway for optional local console
# interception. These are only required by INTERCEPT_MODE=lan.
TARGET_IPS=192.168.1.100
GATEWAY_IP=192.168.1.1
INTERCEPT_MODE=lan

# DNS (console profile infrastructure)
DNS_UPSTREAM=1.1.1.1
DNS_LOG_ALL=true

# --- Optional VPS/public console gateway -----------------------------------
# A remote console can point its manually configured DNS server at the VPS.
# CastNexus then returns PUBLIC_IP for Twitch's plain-RTMP ingest hostnames and
# MediaMTX receives the console stream directly on TCP/1935. No ARP spoofing is
# used in this mode.
#
# IMPORTANT: use your HOME INTERNET'S PUBLIC/WAN IP here, not the console's
# 192.168.x.x LAN address. Keeping this allow-list set prevents the VPS from
# becoming an open recursive DNS server / open RTMP endpoint.
PUBLIC_IP=
PUBLIC_IPV6=
VPS_ALLOWED_CLIENTS=
VPS_ALLOW_ANY=false
VPS_RTMP_PORT=1935
VPS_RTMP_WAIT_SECONDS=60
# Normally docker-compose.vps.yml sets these automatically:
DNS_PUBLIC_MODE=false
DNS_REDIRECT_IP=
DNS_REDIRECT_IPV6=
DNS_ALLOWED_CLIENTS=
DNS_ALLOW_ANY=false
# VPS mode is intentionally plain RTMP only. DNS redirection cannot safely
# impersonate Twitch RTMPS/TLS certificates if a console uses RTMPS instead.

# CastNexus Studio
DASHBOARD_PORT=8090

# Reconnect grace window in milliseconds. Outputs stay ready while a PC or
# console source reconnects instead of ending immediately. Default: 1 hour.
RECONNECT_GRACE_MS=3600000

# Create a Twitch app at https://dev.twitch.tv/console/apps and set its OAuth
# redirect URL to exactly match TWITCH_REDIRECT_URI. The same app credentials
# are used server-side for Helix live checks and automatic VOD discovery.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# LAN example:
# TWITCH_REDIRECT_URI=http://192.168.1.50:8090/auth/twitch/callback
# Reverse-proxy example:
# TWITCH_REDIRECT_URI=https://castnexus.example.com/auth/twitch/callback
TWITCH_REDIRECT_URI=http://192.168.1.50:8090/auth/twitch/callback

# Hardware encoder selection. "auto" probes the installed FFmpeg + real device
# and prefers a usable GPU encoder, then falls back to libx264 automatically.
# Supported probes include NVENC, Intel QSV, VAAPI, AMD AMF, VideoToolbox and
# V4L2 M2M where the host/FFmpeg build provides them.
CASTNEXUS_VIDEO_ENCODER=auto
VAAPI_DEVICE=/dev/dri/renderD128

# Small ARM / Raspberry Pi protection. CPU-only ARM uses a lighter browser +
# x264 render surface so CDP JPEG frames do not back up and trigger the Music
# 24/7 compositor watchdog. GPU-capable ARM keeps the requested profile size.
CASTNEXUS_PI_SAFE_MODE=auto
CASTNEXUS_PI_SAFE_WIDTH=960
CASTNEXUS_PI_SAFE_HEIGHT=540
CASTNEXUS_PI_SAFE_FPS=20
CASTNEXUS_PI_JPEG_QUALITY=60
# If a particularly busy scene still overloads a Pi, an extra-safe profile is:
# CASTNEXUS_PI_SAFE_WIDTH=854
# CASTNEXUS_PI_SAFE_HEIGHT=480
# CASTNEXUS_PI_SAFE_FPS=15
# CASTNEXUS_PI_JPEG_QUALITY=52
RTMP_INPUT_QUEUE=1024
DESTINATION_AUDIO_BITRATE=128k
# YouTube Live's current stereo guidance is 44.1 kHz.
DESTINATION_AUDIO_RATE=44100
# Optional live-transcode overrides:
# DESTINATION_VIDEO_BITRATE=6000k
# DESTINATION_VIDEO_MAXRATE=6000k
# DESTINATION_VIDEO_BUFSIZE=12000k
# DESTINATION_X264_PRESET=veryfast
# COMPOSITOR_AUDIO_BITRATE=128k
# COMPOSITOR_VIDEO_BITRATE=6000k
# COMPOSITOR_VIDEO_MAXRATE=6000k
# COMPOSITOR_VIDEO_BUFSIZE=12000k
# COMPOSITOR_X264_PRESET=veryfast

# Music cover-art fallback. Priority is:
# embedded audio artwork -> providers below -> profile Cover/Logo URL -> note.
# These providers do not require an API key. MusicBrainz requires a meaningful
# User-Agent and limits clients to about one request per second. Apple/iTunes
# promotional-content terms still apply even though the Search API needs no key.
COVER_LOOKUP_PROVIDERS=musicbrainz,itunes
COVER_LOOKUP_TIMEOUT_MS=5000
COVER_LOOKUP_CACHE_HOURS=168
COVER_REMOTE_MAX_MB=10
COVER_MUSICBRAINZ_USER_AGENT=CastNexus/1.0 (https://github.com/NekoSuneProjects/CastNexus)
COVER_ITUNES_COUNTRY=US

# Profile VOD/rerun uploads. This is the maximum size of one uploaded rerun
# video; remote Twitch/YouTube URLs are not counted as local upload storage.
VOD_MAX_GB=20
VOD_X264_PRESET=veryfast
VOD_VIDEO_BITRATE=6000k
VOD_VIDEO_MAXRATE=6500k
VOD_VIDEO_BUFSIZE=12000k
VOD_AUDIO_BITRATE=160k
VOD_FPS=30

# YouTube Data API v3 upload integration for MediaMTX recordings.
# Create a Google OAuth Web Application and enable YouTube Data API v3.
# The redirect URL must exactly match YOUTUBE_REDIRECT_URI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://192.168.1.50:8090/auth/youtube/callback

# Optional CastNexus upload whitelist. Comma-separated Twitch login names or
# Twitch user IDs. Use * to explicitly allow every authenticated CastNexus
# account. Leave blank for normal single-user/self-hosted installs.
YOUTUBE_UPLOAD_ALLOWLIST=

# Local safety guard for the API project's dedicated Video Uploads quota.
# This is deliberately below Google's current default 100 upload calls/day so
# CastNexus leaves headroom. It is a local counter, not Google's live quota UI.
YOUTUBE_UPLOAD_DAILY_SOFT_LIMIT=90

# Music 24/7 worker polling. Each Music profile publishes through its own RTMP
# path/key. The worker waits for MediaMTX to confirm its internal feed and its
# final profile path are ready before reporting ON AIR.
MUSIC24_POLL_MS=2000
MUSIC24_NOW_POLL_MS=750
MUSIC24_START_TIMEOUT_MS=60000
# Optional explicit requested render size. On CPU-only ARM, PI_SAFE_MODE=auto
# clamps this to the CASTNEXUS_PI_SAFE_* surface above to stay realtime.
# MUSIC24_WIDTH=1920
# MUSIC24_HEIGHT=1080
# MUSIC24_FPS=30
