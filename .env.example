# CastNexus Docker release channel
# Stable: latest images + normal GitHub Releases
CASTNEXUS_IMAGE_TAG=latest
CASTNEXUS_CHANNEL=stable
# Beta testing instead:
# CASTNEXUS_IMAGE_TAG=beta
# CASTNEXUS_CHANNEL=beta

# Full advanced reference:
# docs/ADVANCED-CONFIGURATION.md
# Hardware / CPU / GPU sizing:
# docs/HARDWARE-ENCODING.md

# Required. Twitch/Google app secrets remain on the oauth-broker service;
# this installation only ever does a one-time PKCE pairing flow against it.
# Must be an https:// URL.
CASTNEXUS_OAUTH_BROKER_URL=https://castnexus.nekosunevr.co.uk/oauth

# Optional. Base URL of a relaystream deployment (see the `relaystream`
# branch/docs/RELAYSTREAM.md) used by the "push to relaystream" Settings
# toggle to make this install's feed public without opening any ports. Leave
# blank to hide/disable that toggle. Must be reachable at a stable hostname,
# not a raw IP - relaystream is typically fronted by the same reverse proxy
# as the rest of the production deployment.
# RELAYSTREAM_URL=https://castnexus.nekosunevr.co.uk

# Host LAN IP. On a VPS this can be the VPS public IPv4 when you want Studio
# links to advertise that address, although reverse-proxy deployments usually
# use their public domain in the OAuth redirect variables below.
PI_IP=192.168.1.50

# Console LAN IPs (comma separated) and LAN gateway for optional local console
# interception. These are only required by INTERCEPT_MODE=lan. Leave them blank
# for the normal PC / OBS / Music setup.
TARGET_IPS=
GATEWAY_IP=
INTERCEPT_MODE=lan

# DNS (console profile infrastructure)
DNS_UPSTREAM=1.1.1.1
DNS_LOG_ALL=true

# --- Optional VPS/public console gateway -----------------------------------
# A remote console can point its manually configured DNS server at the VPS.
# CastNexus then returns PUBLIC_IP for Twitch's plain-RTMP ingest hostnames and
# MediaMTX receives the console stream directly on TCP/1935. No ARP spoofing is
# used in this mode.
#
# IMPORTANT: use your HOME INTERNET'S PUBLIC/WAN IP here, not the console's
# 192.168.x.x LAN address. Keeping this allow-list set prevents the VPS from
# becoming an open recursive DNS server / open RTMP endpoint.
PUBLIC_IP=
PUBLIC_IPV6=
VPS_ALLOWED_CLIENTS=
VPS_ALLOW_ANY=false
VPS_RTMP_PORT=1935
VPS_RTMP_WAIT_SECONDS=60
# Normally docker-compose.vps.yml sets these automatically:
DNS_PUBLIC_MODE=false
DNS_REDIRECT_IP=
DNS_REDIRECT_IPV6=
DNS_ALLOWED_CLIENTS=
DNS_ALLOW_ANY=false
# VPS mode is intentionally plain RTMP only. DNS redirection cannot safely
# impersonate Twitch RTMPS/TLS certificates if a console uses RTMPS instead.

# CastNexus Studio
DASHBOARD_PORT=8090

# Reconnect grace window in milliseconds. Outputs stay ready while a PC or
# console source reconnects instead of ending immediately. Default: 1 hour.
RECONNECT_GRACE_MS=3600000

# --- Who is allowed to sign in ---------------------------------------------
# By default anybody who completes Twitch OAuth gets a CastNexus account. On an
# internet-reachable install that is usually not what you want.
DISABLE_REGISTRATION=false
# Stricter allowlist. Comma-separated Twitch login names.
# ALLOWED_TWITCH_LOGINS=nekosunevr
# Note: setting DISABLE_REGISTRATION=true on an install with no accounts yet
# can lock everybody out. Name yourself in ALLOWED_TWITCH_LOGINS or leave
# registration open for the first sign-in.

# --- Video encoder ----------------------------------------------------------
# "auto" is recommended. CastNexus checks FFmpeg and performs a real encode
# probe, preferring hardware when it genuinely works and falling back to x264.
# Values include: auto, cpu/libx264, nvenc, qsv, vaapi, amf, videotoolbox,
# v4l2m2m (depending on host/FFmpeg/device support).
CASTNEXUS_VIDEO_ENCODER=auto
VAAPI_DEVICE=/dev/dri/renderD128

# Optional advanced encoder preset overrides. Leave blank for CastNexus
# defaults unless you are deliberately tuning/troubleshooting.
# X264_PRESET=ultrafast
# NVENC_PRESET=p4
# QSV_PRESET=veryfast
# AMF_QUALITY=speed

# CPU x264 encode thread count. Defaults to 2 so one encode can't grab every
# core on a shared/weak host (which starves the other ffmpeg processes
# CastNexus also runs). Raise this only on a host with real spare cores.
# X264_THREADS=2

# --- CPU-only / low-power safe rendering -----------------------------------
# CPU safe mode protects any host that has no working hardware encoder, not
# only Raspberry Pi. "auto" enables the clamp when hardware encoding is absent.
CASTNEXUS_CPU_SAFE_MODE=auto
CASTNEXUS_CPU_SAFE_WIDTH=960
CASTNEXUS_CPU_SAFE_HEIGHT=540
CASTNEXUS_CPU_SAFE_FPS=20
CASTNEXUS_CPU_JPEG_QUALITY=60

# Extra-safe example for a busy/shared/low-power CPU:
# CASTNEXUS_CPU_SAFE_MODE=true
# CASTNEXUS_CPU_SAFE_WIDTH=640
# CASTNEXUS_CPU_SAFE_HEIGHT=360
# CASTNEXUS_CPU_SAFE_FPS=10
# CASTNEXUS_CPU_JPEG_QUALITY=50
# X264_PRESET=ultrafast

# Older compatibility aliases. CPU_* above takes priority when set.
CASTNEXUS_PI_SAFE_MODE=auto
CASTNEXUS_PI_SAFE_WIDTH=960
CASTNEXUS_PI_SAFE_HEIGHT=540
CASTNEXUS_PI_SAFE_FPS=20
CASTNEXUS_PI_JPEG_QUALITY=60

# --- Live input / destination outputs --------------------------------------
RTMP_INPUT_QUEUE=1024
DESTINATION_AUDIO_BITRATE=128k
# YouTube Live's current stereo guidance is 44.1 kHz.
DESTINATION_AUDIO_RATE=44100
# These mainly affect destinations that require a video transcode (Landscape /
# Vertical). Source layout normally copies video and only normalizes audio.
# DESTINATION_FPS=30
# DESTINATION_VIDEO_BITRATE=6000k
# DESTINATION_VIDEO_MAXRATE=6000k
# DESTINATION_VIDEO_BUFSIZE=12000k
# DESTINATION_X264_PRESET=veryfast

# --- Browser / overlay / Music compositor ---------------------------------
# auto = use hardware-aware Chromium path when supported, software rendering
# otherwise. GPU encoding still uses some CPU for browser rendering/audio/etc.
# COMPOSITOR_GPU=auto
# COMPOSITOR_WIDTH=1280
# COMPOSITOR_HEIGHT=720
# COMPOSITOR_FPS=30
# COMPOSITOR_JPEG_QUALITY=70
# COMPOSITOR_AUDIO_BITRATE=128k
# COMPOSITOR_VIDEO_BITRATE=6000k
# COMPOSITOR_VIDEO_MAXRATE=6000k
# COMPOSITOR_VIDEO_BUFSIZE=12000k
# COMPOSITOR_X264_PRESET=veryfast
# COMPOSITOR_DEBUG=false
# COMPOSITOR_AUDIO_FIFO=false
# Browser capture rate fed to FFmpeg (blank = same as COMPOSITOR_FPS).
# COMPOSITOR_RENDER_FPS=
# Scene decoration effects in the server renderer: auto | full | reduced | minimal.
# auto = reduced unless COMPOSITOR_GPU=true (full 60 Hz animations cost several
# CPU cores in software Chromium). Also settable in Overlay Studio.
# COMPOSITOR_EFFECTS=auto
# Frame pump timestamps: auto (default: wallclock on FFmpeg <=6, cfr on 7+) | cfr | wallclock
# COMPOSITOR_PUMP_TIMESTAMPS=auto
# Restart a program encoder that falls this many seconds behind real time
# (drops the queued backlog so stream delay cannot keep growing). 0 = off.
# COMPOSITOR_MAX_LAG_S=3

# --- Automatic hardware test ------------------------------------------------
# Before streaming, CastNexus tests the host (Pi / VPS / PC, GPU encoder, real
# browser GPU, CPU speed) and Auto picks the best resolution/FPS it can hold.
# Share of all CPU cores Auto may plan to use (default: Pi 0.7, VPS 0.5, PC 0.35).
# CASTNEXUS_AUTO_CPU_BUDGET=
# Set false to skip the test (Auto then uses conservative estimates).
# CASTNEXUS_HARDWARE_PROBE=true
# Leave COMPOSITOR_WIDTH/HEIGHT/FPS unset to let Auto size the overlay programs.

# --- Overlay Studio programs / browser sources / destinations --------------
# Browser-source audio capture (StreamElements alerts etc.) via a private
# PulseAudio null sink inside the container: auto | false
# CASTNEXUS_BROWSER_AUDIO=auto
# Stop public overlay pages from calling loopback/private network services
# (MediaMTX API, the dashboard) from inside the renderer. Keep true.
# CASTNEXUS_BROWSER_BLOCK_LOCAL_NETWORK=true
# A program renderer with no consuming destination stops after this long.
# PROGRAM_IDLE_STOP_MS=15000
# Destinations that re-encode to identical settings share one encode.
# DESTINATION_SHARED_RENDITIONS=true
# Destination restart backoff (exponential between these bounds).
# DESTINATION_RESTART_MIN_MS=2000
# DESTINATION_RESTART_MAX_MS=60000
# Resource diagnostics sampling interval (Linux; Windows is at least 15 s).
# CASTNEXUS_MONITOR_INTERVAL_MS=2000
# --- Idle resource saving ---------------------------------------------------
# After the source (OBS/console) has been offline this long, renderers and
# destination pushes pause to save CPU; they restart when it reconnects.
# Shorter dropouts keep everything running so platforms do not end the stream.
# 0 = keep running for the whole RECONNECT_GRACE_MS window.
# RECONNECT_IDLE_STOP_MS=120000
# Stop a program renderer when none of its destinations is live for this long.
# PROGRAM_NO_CONSUMER_STOP_MS=90000
# A destination that fails this many times in a row stops retrying (0 = never).
# DESTINATION_MAX_RETRIES=20
# Keep Music 24/7 rendering even with no enabled destination/relay/recording.
# MUSIC24_ALWAYS_ON=false
# Music 24/7 streaming is OFF after every start/restart until you press
# "Turn on" on the Music page, so a restart never leaves it idling. Set true
# to start it automatically again (old behaviour).
# MUSIC24_AUTOSTART=false
# Future server-generated captions provider id (none ship yet).
# CASTNEXUS_CAPTION_PROVIDER=

# --- Music cover-art fallback ----------------------------------------------
# Priority: embedded artwork -> providers below -> profile Cover/Logo URL.
COVER_LOOKUP_PROVIDERS=musicbrainz,itunes
COVER_LOOKUP_TIMEOUT_MS=5000
COVER_LOOKUP_CACHE_HOURS=168
COVER_REMOTE_MAX_MB=10
COVER_MUSICBRAINZ_USER_AGENT=CastNexus/1.0 (https://github.com/NekoSuneProjects/CastNexus)
COVER_ITUNES_COUNTRY=US

# --- Profile VOD / rerun uploads -------------------------------------------
# This is the maximum size of one uploaded rerun video; it is not a total disk
# quota. Recordings can continue growing until you delete/manage them.
VOD_MAX_GB=20
VOD_X264_PRESET=veryfast
VOD_VIDEO_BITRATE=6000k
VOD_VIDEO_MAXRATE=6500k
VOD_VIDEO_BUFSIZE=12000k
VOD_AUDIO_BITRATE=160k
VOD_FPS=30

# --- YouTube Data API v3 upload integration --------------------------------
# Optional CastNexus upload whitelist. Comma-separated Twitch login names or
# Twitch user IDs. Use * to explicitly allow every authenticated CastNexus
# account. Leave blank for normal single-user/self-hosted installs.
YOUTUBE_UPLOAD_ALLOWLIST=

# Local safety guard for the API project's dedicated Video Uploads quota.
# This is a local counter, not Google's live quota UI.
YOUTUBE_UPLOAD_DAILY_SOFT_LIMIT=90

# --- Music 24/7 worker ------------------------------------------------------
# Each Music profile publishes through its own RTMP path/key. The worker waits
# for MediaMTX to confirm readiness before reporting ON AIR.
MUSIC24_POLL_MS=2000
# Now-playing is event driven; this is only the safety resync interval.
MUSIC24_NOW_POLL_MS=5000
MUSIC24_START_TIMEOUT_MS=60000
MUSIC24_EMBED_START_DELAY_MS=500
# Requested output. CPU safe mode may clamp this lower on software-only hosts.
# MUSIC24_WIDTH=1920
# MUSIC24_HEIGHT=1080
# MUSIC24_FPS=30
# Defaults for new Music profiles. Normally set per profile in the dashboard:
# Music / 24/7 -> Performance & encoder.
# MUSIC24_PERFORMANCE_MODE=auto      # auto | max | balanced | low | ultra
# MUSIC24_ENCODER=auto               # auto | nvenc | qsv | vaapi | amf | cpu
# MUSIC24_RENDER_FPS=                # 10 15 20 24 30 60 (blank = mode default)
# MUSIC24_SPECTRUM_HZ=               # blank = mode default
# MUSIC24_JPEG_QUALITY=              # intermediate capture quality, blank = mode default
# MUSIC24_VIDEO_BITRATE=3500k

# --- NVIDIA (docker-compose.gpu-nvidia.yml) ---------------------------------
# NVENC needs the "video" driver capability inside the container.
# NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# --- VRChat relay diagnostics ----------------------------------------------
# VRCHAT_RELAY_POLL_MS=1500
# VRCHAT_RELAY_DEBUG=false
