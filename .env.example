# CastNexus intercept configuration.
CASTNEXUS_IMAGE_TAG=latest

# --- LAN mode (ARP + DNAT interception) -------------------------------------
INTERCEPT_MODE=lan
IFACE=eth0
PI_IP=192.168.1.50
GATEWAY_IP=
TARGET_IPS=

# --- VPS/public console gateway ---------------------------------------------
# Plain-RTMP-only public listener. Keep VPS_ALLOWED_CLIENTS set to your home
# internet's public/WAN IP - do not leave VPS_ALLOW_ANY=true on the internet.
VPS_RTMP_PORT=1935
VPS_RTMP_WAIT_SECONDS=60
VPS_ALLOWED_CLIENTS=
VPS_ALLOW_ANY=false
