# Raspberry Pi LAN IP
PI_IP=192.168.1.50

# Console LAN IPs (comma separated) and LAN gateway, for the DNS hijack +
# ARP-spoof/DNAT intercept that transparently captures a physical console's
# (e.g. PS5) own Twitch broadcast. Leave TARGET_IPS blank if you don't have a
# console to capture - ./install.sh then skips the dns/intercept containers
# entirely and only runs mediamtx + dashboard (OBS/streaming software can
# still push straight to mediamtx regardless of these being set).
#
# This only controls whether console-capture *infrastructure* runs at all.
# Which source(s) an individual dashboard account actually uses - console,
# PC streaming software, or both - is chosen per-account after signing in,
# not here.
TARGET_IPS=192.168.1.100
GATEWAY_IP=192.168.1.1

# DNS (only relevant if TARGET_IPS is set above)
DNS_UPSTREAM=1.1.1.1
DNS_LOG_ALL=true

# Dashboard (http://PI_IP:8090) - multi-account, sign in with Twitch. On
# first login, each account picks its source (console / PC streaming
# software / both) and pastes its Twitch stream key; incoming streams are
# matched to an account by that stream key. Playback URLs are served from a
# per-account "public/<twitch-username>" path - never the real stream key.
DASHBOARD_PORT=8090

# If a stream drops unexpectedly and there's no other source to fail over
# to, outputs aren't torn down right away - the dashboard waits this long
# (milliseconds) for the same source to reconnect (flaky wifi, a console
# reboot, OBS crashing and relaunching, etc.) before actually ending the
# stream and stopping every destination. Default: 1 hour.
RECONNECT_GRACE_MS=3600000

# Create a Twitch app at https://dev.twitch.tv/console/apps - set its OAuth
# Redirect URL to exactly match TWITCH_REDIRECT_URI below. Any http(s) URL
# works here - a plain LAN IP:port, or a domain with no port at all if
# you're fronting the dashboard with a reverse proxy (e.g. Nginx Proxy
# Manager) that terminates TLS on 443 and forwards to PI_IP:DASHBOARD_PORT.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# LAN-only example:
# TWITCH_REDIRECT_URI=http://192.168.1.50:8090/auth/twitch/callback
# Reverse-proxied domain example:
# TWITCH_REDIRECT_URI=https://restream.example.com/auth/twitch/callback
TWITCH_REDIRECT_URI=http://192.168.1.50:8090/auth/twitch/callback
