# CastNexus CLI configuration. Copy to .env next to where you run the CLI.

# Required. The oauth-broker service is the only supported way to sign in -
# must be an https:// URL. Sign in from a browser at the dashboard URL once
# it's running (http://localhost:8090/login by default).
CASTNEXUS_OAUTH_BROKER_URL=https://castnexus.nekosunevr.co.uk/oauth

DASHBOARD_PORT=8090
PI_IP=

# --- YouTube Data API v3 upload integration --------------------------------
YOUTUBE_UPLOAD_ALLOWLIST=
YOUTUBE_UPLOAD_DAILY_SOFT_LIMIT=90

# --- Who is allowed to sign in ---------------------------------------------
DISABLE_REGISTRATION=false
# ALLOWED_TWITCH_LOGINS=nekosunevr
