# CastNexus relaystream service configuration.
# See docs/RELAYSTREAM.md for the full design and API surface.

# Port the admin/auth API listens on inside its container.
RELAYSTREAM_PORT=8092

# Public URL this relay is reachable at (behind your reverse proxy).
RELAYSTREAM_PUBLIC_URL=https://castnexus.nekosunevr.co.uk

# Required. Random 32+ byte secret used to sign push tokens.
RELAYSTREAM_SIGNING_SECRET=

# Required. Bearer token for the admin endpoints (list/ban/unban nodes).
RELAYSTREAM_ADMIN_TOKEN=

# Set to "true" when running behind a reverse proxy so client IPs used for
# rate limiting are read from X-Forwarded-For.
RELAYSTREAM_TRUST_PROXY=true

# How long an issued push token stays valid, in milliseconds.
# RELAYSTREAM_PUSH_TOKEN_TTL_MS=21600000

# MediaMTX Control API base URL used to cross-check which nodes are actually
# live when listing nodes in the admin API.
MEDIAMTX_API=http://relaystream-mediamtx:9997
