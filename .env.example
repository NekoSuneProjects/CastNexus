# CastNexus oauth-broker service configuration.
# See docs/HOSTED-OAUTH.md for the full design and API surface.

# Port the broker listens on inside its container.
OAUTH_BROKER_PORT=8091

# Public URL this broker is reachable at (behind your reverse proxy).
OAUTH_BROKER_PUBLIC_URL=https://castnexus.nekosunevr.co.uk/oauth
CASTNEXUS_SITE_URL=https://castnexus.nekosunevr.co.uk

# Required. Random 32+ byte secret used to sign OAuth state and broker tokens.
OAUTH_BROKER_SIGNING_SECRET=

# Set to "true" when running behind a reverse proxy so client IPs used for
# rate limiting are read from X-Forwarded-For.
OAUTH_TRUST_PROXY=true

# How long a pending PKCE transaction stays valid, in milliseconds.
# OAUTH_TRANSACTION_TTL_MS=600000

# Required. Twitch application credentials (https://dev.twitch.tv/console/apps).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Required. Google/YouTube OAuth application credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
