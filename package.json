{
  "name": "castnexus",
  "version": "0.1.0",
  "description": "Professional broadcast streaming for PS5, Switch, and PC",
  "license": "MIT",
  "repository": "NekoSuneProjects/CastNexus",
  "scripts": {
    "install:all": "npm install && npm --prefix dashboard install && npm --prefix electron install && npm --prefix cli install && npm --prefix dns install && npm --prefix oauth-broker install",
    "test": "npm --prefix dashboard test",
    "test:watch": "node --test --watch dashboard/**/*.test.js",
    "dev:dashboard": "npm --prefix dashboard start",
    "dev:electron": "npm --prefix electron start",
    "dev:cli": "npm --prefix cli start",
    "build:electron": "npm --prefix electron run build",
    "build:cli": "npm --prefix cli run pkg:build",
    "docker:build": "docker build -f dashboard/Dockerfile -t castnexus:latest .",
    "docker:compose": "docker-compose -f compose.yaml up -d",
    "docker:logs": "docker logs -f castnexus-dashboard"
  },
  "workspaces": [
    "dashboard",
    "electron",
    "cli",
    "dns",
    "oauth-broker"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "streaming",
    "rtmp",
    "broadcast",
    "ps5",
    "switch",
    "twitch"
  ]
}
