{
  "name": "castnexus-relaystream-repo",
  "version": "1.3.2",
  "description": "CastNexus relaystream - public relay for NAT'd/no-open-port installs",
  "license": "MIT",
  "repository": "NekoSuneProjects/CastNexus",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix relaystream install",
    "test": "npm --prefix relaystream test",
    "dev": "npm --prefix relaystream start",
    "docker:build": "docker build -f relaystream/Dockerfile -t castnexus-relaystream:latest .",
    "docker:compose": "docker compose up -d"
  },
  "workspaces": [
    "relaystream"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
