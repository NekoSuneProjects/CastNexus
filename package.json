{
  "name": "castnexus-oauth-broker-repo",
  "version": "0.1.0",
  "description": "CastNexus oauth-broker - standalone Twitch/YouTube OAuth2 broker",
  "license": "MIT",
  "repository": "NekoSuneProjects/CastNexus",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix oauth-broker install",
    "test": "npm --prefix oauth-broker test",
    "dev": "npm --prefix oauth-broker start",
    "docker:build": "docker build -f oauth-broker/Dockerfile -t castnexus-oauth-broker:latest .",
    "docker:compose": "docker compose up -d"
  },
  "workspaces": [
    "oauth-broker"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
