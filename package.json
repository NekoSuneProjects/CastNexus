{
  "name": "castnexus-dns-repo",
  "version": "1.3.3",
  "description": "CastNexus dns - console DNS-capture helper service",
  "license": "MIT",
  "repository": "NekoSuneProjects/CastNexus",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix dns install",
    "test": "npm --prefix dns test",
    "dev": "node dns/server.js",
    "docker:build": "docker build -f dns/Dockerfile -t castnexus-dns:latest .",
    "docker:compose": "docker compose up -d"
  },
  "workspaces": [
    "dns"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
