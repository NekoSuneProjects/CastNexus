{
  "name": "castnexus-desktop-electron",
  "version": "0.1.0",
  "description": "CastNexus Desktop - Professional broadcast streaming for PS5, Switch, and PC",
  "main": "main.js",
  "homepage": "https://github.com/NekoSuneProjects/CastNexus",
  "repository": "NekoSuneProjects/CastNexus",
  "author": "NekoSuneVR <noreply@github.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.castnexus.desktop",
    "productName": "CastNexus Studio",
    "publish": null,
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "download-manager.js",
      "../dashboard",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../tools",
        "to": "tools"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
