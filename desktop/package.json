{
  "name": "castnexus-desktop",
  "private": true,
  "version": "0.0.0-dev",
  "bin": "launcher.js",
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "build-info.json",
